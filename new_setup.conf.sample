# new_setup 설정 파일 샘플 — new_setup.conf 로 복사해서 사용 (실행 파일 옆, 또는 -c 로 지정)
# '#' 로 시작하는 줄과 빈 줄은 무시. 값은 '=' 뒤 전체(앞뒤 공백만 제거, GOSSH 외에는 따옴표 처리 없음).

# gossh 경로. 비우면 PATH 에서 찾는다. 따옴표·~/·폴더(그 안의 gossh 사용)도 허용.
GOSSH=

# 디스크미인식 판정 문구(고정 문자열, 여러 줄 가능). 하나도 없으면 아래 기본 문구 1개를 쓴다.
# anaconda.log 에 이 문구가 있으면 '디스크미인식'.
DISK_PATTERN=Disk "" given in clearpart command does not exist

# 설치정지 판정 문구(고정 문자열, 여러 줄 가능). 처음엔 비워 두고 현장에서 채운다.
# 판정 우선순위: 디스크미인식 > 설치정지 > OS설치중
# ※ 문구에 reboot/poweroff/shutdown/halt/init 0/init 6/ddc 등 gossh 위험어가 들어 있으면 실행이 거부된다.
#ERROR_PATTERN=

# ---- v2: 설정체크 / CPU / stress-ng / H/T / OS 열 ----

# config_check.sh 경로 (관리서버에 있는 파일). 비우면 설정체크 열은 '-'.
# -auto-check 를 지원하는 버전이어야 한다(없으면 실행하지 않고 '-' + 경고).
OS_CHECK_SH=

# 설정체크 제외 hostname 문자열('|' 로 구분). 하나라도 hostname 에 포함되면 FAIL 이어도 'O'.
# 예: OS_CHECK_EXCLUDE=asdf|qwer
OS_CHECK_EXCLUDE=

# CPU테스트: 'O' / 'X' / 'NOTRUN'. 그 벤더의 CPU 테스트 로그 파일이 없으면 NOTRUN(부하테스트 아직 안 함).
# CPU_* 값은 따옴표로 감싸도 된다. LOG 파일 이름에 * ? 를 쓰면 그 폴더에서 가장 최근 파일을 쓴다
# (폴더 부분에는 와일드카드·공백 불가). 벤더 검사를 끄려면 LOG 를 비운다(예: CPU_AMD_LOG=) -> 그 벤더는 'X'.

# Intel CPU 진단 로그 경로와 성공 문구(고정 문자열, 대소문자 무시). 로그에 문구가 있으면 CPU테스트 'O'.
CPU_INTEL_LOG=/var/cpudiag/result.log
CPU_INTEL_OK=Completed successfully. No issues detected.
# 지정하면 이 문자열이 든 줄만 검사하고 그 줄이 모두 성공 문구를 포함해야 'O'. 비우면 문구가 로그 어디에든 있으면 'O'.
#CPU_INTEL_LINE=

# AMD: 현장 수동 확인 'grep Result /var/cpudiag/results.json' 결과가 모두 PASS 인지와 같은 규칙.
# LINE(Result) 이 든 줄이 1개 이상이고 모두 OK(PASS) 문구를 포함하면 CPU테스트 'O'.
CPU_AMD_LOG=/var/cpudiag/results.json
CPU_AMD_OK=PASS
CPU_AMD_LINE=Result
