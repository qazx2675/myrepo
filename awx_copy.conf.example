# awx_copy 설정파일 예시
# 리눅스: ~/.awx_copy.conf 로 복사하고 chmod 600
# 윈도우: awx_fetch.exe 옆에 awx_copy.conf 로 복사
# 형식: key = value  (# 로 시작하면 주석)

url = http://192.168.0.58:30080
username = test.kim
# 비밀번호를 직접 적는다. 이 파일은 커밋하지 않는다.
password =
inventory_id = 5
# 조각 하나의 base64 문자 수. 측정 한도 x 0.5 이하 (docs/limits.md 참고)
chunk_size = 1048576
# 상대측 응답과 HTTP 요청의 최대 대기 시간(초)
timeout = 300
