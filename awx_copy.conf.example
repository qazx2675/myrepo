# awx_copy 설정파일 예시 (이 파일을 복사해 값을 채운다. 비밀번호가 들어가므로 저장소에 커밋하지 않는다)
# 리눅스: /etc/awx_copy/{user}.conf (소유자 = 해당 사용자, chmod 600)
# 윈도우: awx_fetch.exe 옆 conf\{user}.conf (창 앱에서 만들면 비밀번호는 DPAPI 로 암호화됨)
# 형식: key = value  (# 로 시작하면 주석)

url = http://192.168.0.58:30080
username = test.kim
password =
# 업로더와 다운로더가 같은 inventory_id 를 써야 서로 만난다
inventory_id = 5
# 조각 하나의 최대 문자 수 (1 MiB 이하. docs/limits.md 참고)
chunk_size = 1048576
# 상대측 응답과 HTTP 요청의 최대 대기 시간(초)
timeout = 300
