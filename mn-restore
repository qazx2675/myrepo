#!/bin/bash
# mn-restore - mn 목록 출력(트리)을 dir.conf 로 되돌린다 (RHEL6 bash 4.1 호환)
#
# 사용법: mn-restore [-i 입력파일] [-o 출력파일]
#   입력  : -i 파일 > 파이프(stdin) > 아무것도 없으면 mn 을 직접 실행해서 사용
#   출력  : 기본 ${MN_CONF:-/etc/dir/dir.conf},  -o - 이면 화면에 출력
#   기존 출력 파일이 있으면 <파일>.bak.<시각> 으로 백업한 뒤 덮어쓴다.
#
# 예)  mn-restore                          # 현재 mn 출력으로 dir.conf 복원
#      mn > saved.txt  →  mn-restore -i saved.txt -o /tmp/dir.conf.new
#
# 주의: 색 코드는 자동으로 제거한다. 주석(#)·빈 줄·번호 [n] 은 mn 출력에 없어서 복원되지 않는다.
#       경로의 ~ 는 mn 이 이미 $HOME 으로 풀어서 출력하므로 절대경로로 복원된다.

IN=""; OUT="${MN_CONF:-/etc/dir/dir.conf}"
while [ $# -gt 0 ]; do
    case "$1" in
        -i) IN="${2:-}"; shift 2 ;;
        -o) OUT="${2:-}"; shift 2 ;;
        -h|--help|help)
            sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        *) echo "오류: 알 수 없는 인자: $1  (mn-restore -h)" >&2; exit 1 ;;
    esac
done
[ -z "$OUT" ] && { echo "오류: 출력 파일 경로가 비어 있습니다." >&2; exit 1; }

# ---- 입력 읽기 (색 코드·CR 제거) ----
ESC=$(printf '\033')
if [ -n "$IN" ]; then
    [ -r "$IN" ] || { echo "오류: 입력 파일을 읽을 수 없습니다: $IN" >&2; exit 1; }
    RAW=$(cat "$IN")
elif [ ! -t 0 ]; then
    RAW=$(cat)
else
    MNBIN=$(command -v mn 2>/dev/null || true)
    [ -z "$MNBIN" ] && [ -x "$(dirname "$0")/mn" ] && MNBIN="$(dirname "$0")/mn"
    [ -z "$MNBIN" ] && { echo "오류: mn 을 찾을 수 없습니다. 저장해 둔 출력이 있으면 -i 파일 로 지정하세요." >&2; exit 1; }
    RAW=$("$MNBIN" ls 2>&1) || { echo "오류: mn 실행 실패. 저장해 둔 출력이 있으면 -i 파일 로 지정하세요." >&2; echo "$RAW" >&2; exit 1; }
fi
TEXT=$(printf '%s\n' "$RAW" | sed -e "s/${ESC}\[[0-9;]*m//g" -e 's/\r$//')

# ---- 트리 → conf ----
OUTTXT=""; last_hdr=""; NSEC=0; NENT=0
top=""; sub=""
pname=""; pdesc=""; have=0

flush() {
    [ "$have" = 1 ] || return 0
    local sec="$top" rest line first=1
    [ -n "$sub" ] && sec="$top/$sub"
    if [ "$sec" != "$last_hdr" ]; then
        [ -n "$last_hdr" ] && OUTTXT+=$'\n'
        OUTTXT+="[$sec]"$'\n'
        last_hdr="$sec"; NSEC=$((NSEC + 1))
    fi
    if [ -n "$pdesc" ]; then
        while IFS= read -r line; do
            if [ "$first" = 1 ]; then OUTTXT+="$pname | $line"$'\n'; first=0
            else OUTTXT+="  $line"$'\n'; fi
        done <<< "$pdesc"
    else
        OUTTXT+="$pname"$'\n'
    fi
    NENT=$((NENT + 1)); have=0; pname=""; pdesc=""
}

while IFS= read -r line; do
    [ -z "${line//[[:space:]]/}" ] && continue
    case "$line" in 번호로\ 이동:*|이동:*) continue ;; esac

    if [[ $line =~ ^[^[:space:]] ]]; then               # 최상위 섹션 제목
        flush; top="$line"; sub=""; continue
    fi
    if [[ $line =~ ^([[:space:]]+)\|_[[:space:]]?(.*)$ ]]; then   # 설명 첫 줄
        pdesc="${BASH_REMATCH[2]}"; continue
    fi
    # 항목은 들여쓰기 1칸(하위분류 없음) 또는 3칸(하위분류 안). 더 깊으면 "- " 로 시작하는 설명 이어쓰기 줄
    if [[ $line =~ ^([[:space:]]+)-[[:space:]]+(.*)$ ]] && [ "${#BASH_REMATCH[1]}" -le 3 ]; then
        flush
        ind=${#BASH_REMATCH[1]}; nm="${BASH_REMATCH[2]}"
        [ "$ind" -le 1 ] && sub=""                       # 하위분류 없는 항목(들여쓰기 1칸)
        nm=$(printf '%s' "$nm" | sed -e 's/^\[[0-9]\{1,\}\] //' -e 's/[[:space:]]*$//')
        pname="$nm"; pdesc=""; have=1; continue
    fi
    t="${line#"${line%%[![:space:]]*}"}"
    pre="${line%"$t"}"
    if [ "${#pre}" -le 1 ]; then                         # 하위분류 이름(들여쓰기 1칸)
        flush; sub="${t%"${t##*[![:space:]]}"}"; continue
    fi
    # 그 외: 직전 항목의 추가 설명 줄
    t="${t%"${t##*[![:space:]]}"}"
    if [ "$have" = 1 ]; then
        if [ -n "$pdesc" ]; then pdesc+=$'\n'"$t"; else pdesc="$t"; fi
    fi
done <<< "$TEXT"
flush

if [ "$NENT" -eq 0 ]; then
    echo "오류: 입력에서 항목을 하나도 찾지 못했습니다. mn 의 목록 출력인지 확인하세요." >&2
    exit 1
fi

# ---- 출력 ----
if [ "$OUT" = "-" ]; then
    printf '%s' "$OUTTXT"
    exit 0
fi
mkdir -p "$(dirname "$OUT")" 2>/dev/null
if [ -e "$OUT" ]; then
    BAK="$OUT.bak.$(date +%Y%m%d%H%M%S)"
    cp -p "$OUT" "$BAK" || { echo "오류: 백업 실패: $BAK" >&2; exit 1; }
    echo "백업: $BAK"
fi
TMP="$OUT.tmp.$$"
printf '%s' "$OUTTXT" > "$TMP" && chmod 644 "$TMP" && mv -f "$TMP" "$OUT" \
    || { rm -f "$TMP"; echo "오류: $OUT 에 쓸 수 없습니다 (권한 확인)." >&2; exit 1; }
echo "복원: $OUT  (섹션 $NSEC, 항목 $NENT)"

# ---- 되돌려 본 결과 확인: 복원한 conf 로 mn 을 다시 돌려 입력과 비교 ----
MNBIN=$(command -v mn 2>/dev/null || true)
[ -z "$MNBIN" ] && [ -x "$(dirname "$0")/mn" ] && MNBIN="$(dirname "$0")/mn"
if [ -n "$MNBIN" ]; then
    REGEN=$(MN_CONF="$OUT" "$MNBIN" ls 2>/dev/null | sed "s/${ESC}\[[0-9;]*m//g")
    WANT=$(printf '%s\n' "$TEXT" | grep -v -e '^번호로 이동:' -e '^이동:' | sed '/^[[:space:]]*$/d')
    if [ "$REGEN" = "$WANT" ]; then
        echo "확인: 복원한 conf 로 mn 을 다시 실행한 결과가 입력과 같습니다."
    else
        echo "경고: 복원한 conf 의 mn 출력이 입력과 다릅니다 (일부 검색 결과만 넣은 경우 등). 내용을 확인하세요: $OUT" >&2
    fi
fi
