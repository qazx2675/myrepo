                         { print $1 "\t" (($1 in r) ? r[$1] : $2) }' "$TMP/recheck.state" "$TMP/first.state" > "$TMP/final.state"
             FINAL="$TMP/final.state"
@@ -325,6 +429,10 @@ esac
 
