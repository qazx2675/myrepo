# auto_setup 설정 파일 — 이 파일을 auto_setup.conf 로 복사해 값을 채운다 (빌드 불필요).
# 형식: 키=값 (# 주석, 값의 따옴표는 선택). 비워 두면 기본 동작.
# 빌드 때 -ldflags -X 로 넣은 값이 있으면 그 값이 우선한다.
#
# 설정 파일 위치 (먼저 발견된 하나만 사용):
#   1) $AUTO_SETUP_CONF/auto_setup.conf
#   2) <auto_setup 실행 파일 디렉터리>/conf/auto_setup.conf
#   3) /etc/auto_setup/auto_setup.conf   (setup.sh 가 conf/auto_setup.conf 를 여기에 설치)

# 모든 대역 접근 가능한 서버 (비우면 os6 경로 미사용)
# (v0.4.0) os8 에서 ping·준비확인이 안 되는 호스트는 설치 중에도 이 서버 경유로 자동 전환
os6_mgmt=
# os6_mgmt 위 gossh 실행 파일 전체 경로
os6_gossh=
# os6_mgmt 위 auto_setup(os6 빌드) 이 있는 디렉터리
os6_autosetup=
# 이 서버의 os_check_final_annotated.sh 전체 경로 (autofs 공유 경로면 os8_mgmt·os6_mgmt 동일)
os_check_sh=
# awx 스크립트 경로 (awxkit/dhcp.sh 등이 있는 awx_script 디렉터리)
awx_dir=

# (v0.6.0) AWX 실행 프로파일 (선택, 최대 9개) — TUI 에서 w 로 AWX 를 실행할 때 고르는 미리 정한 답변 묶음
# 형식: awx_profile_N=nodeinfo(y/n)|OS값|설명   (설명은 비워도 되고 공백이 들어가도 된다)
# OS값: 2024 2025 2026 2026-OPC_MDP 2026-ECAD_TCAD default   (형식이 틀린 프로파일은 목록에서 빠지고 사유가 표시됨)
#   예) awx_profile_1=y|2025|nodeinfo 사용, 모든 yml 을 OS 2025 로
#   예) awx_profile_2=n|2026-OPC_MDP|nodeinfo 미사용, OPC_MDP
awx_profile_1=
awx_profile_2=
awx_profile_3=
awx_profile_4=
awx_profile_5=
awx_profile_6=
awx_profile_7=
awx_profile_8=
awx_profile_9=

# 비어 있지 않으면 원격 클라이언트 모드 (os6_mgmt 에서 채움)
os8_mgmt=
# os8_mgmt 위 auto_setup 경로 (비면 /usr/local/bin/auto_setup)
os8_autosetup=
# os6_mgmt 위 os_check 경로 (2차 체크용). 비우면 os_check_sh 와 같은 경로, "-" 면 2차 체크 끄기
os6_os_check_sh=
# LDAP 복원용 autofs 공유 경로 (대상 root 가 읽을 수 있어야 함). 비우면 자동 복원 안 함
ldap_share_dir=

# (v0.7.0) TUI 변경 메뉴 (m 키: IP 변경 / LDAP 변경 / 원복) — 비우면 꺼짐(기존 화면·키 그대로)
# 켜짐 값: y, yes, 1, true (대소문자 무시). 그 외는 꺼짐. `auto_setup --admin` 으로 TUI 를 띄우면 conf 와 무관하게 켜진다.
# 변경 conf(ip_change.conf, ldap_config.conf, assets.txt)는 이 파일이 있는 디렉터리(없으면 /etc/auto_setup)에서 읽는다 (setup.sh 가 샘플을 설치).
enable_ip_change=
enable_ldap_change=
# 변경 엔진 실행 파일 전체 경로. 비우면 <auto_setup 실행 파일 디렉터리>/ip-change-engine → PATH 순으로 찾는다 (setup.sh 는 /usr/local/bin 에 설치)
ip_engine=
# 위와 같음: ldap-config-engine
ldap_engine=

# (v0.8.0) 신규 설치 양식 템플릿 (선택, 최대 9개) — TUI 에서 w → 2 (CLI: auto_setup newhost) 로 01 의 12필드 양식을 만들 때 고르는 설치 값 묶음
# 형식: newhost_template_N=별칭|infra nic disk 용량 os boot   (별칭은 비워도 되고 `|` 자체를 생략해도 된다)
#   disk: sda 또는 nvme (root 파티션은 sda → sda5, nvme → nvme0n1p8 로 정해짐) / 용량: 숫자 / boot: uefi, legacy, 레거시 / 나머지는 공백 없는 문자열
#   이름은 값으로 자동 생성된다: infra-nic-disk-용량-os-boot (예 sec-bond-sda-500-8.10-uefi). 형식이 틀린 템플릿은 목록에서 빠지고 사유가 표시됨
#   예) newhost_template_1=A|sec bond sda 500 8.10 uefi
#   예) newhost_template_2=mec eth0 nvme 400 9.6 uefi
newhost_template_1=
newhost_template_2=
newhost_template_3=
newhost_template_4=
newhost_template_5=
newhost_template_6=
newhost_template_7=
newhost_template_8=
newhost_template_9=

# (v0.8.0) gossh 작업(s 키)의 실행 위치 기준 대수 — 이 대수 이하는 os8 gossh 로 실행(접속불가는 os6_mgmt 경유 재실행), 초과하면 전량 os6_mgmt 경유
# 숫자 (1 이상). 비우거나 숫자가 아니면 1000
work_os6_over=

# 종료된 작업(jobs/done)을 TUI·status 에 보여 주는 기간(일) — 숫자 (1 이상). 비우거나 숫자가 아니면 1 (24시간)
# 지난 작업은 파일이 지워지는 것이 아니라 화면에서만 빠진다. 값을 늘리면 그 기간의 작업이 날짜별 보기(← →)에 다시 나온다 (TUI 를 다시 열면 바로 적용)
closed_keep_days=
