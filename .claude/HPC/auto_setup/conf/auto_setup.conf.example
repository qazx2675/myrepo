# auto_setup 설정 파일 — 이 파일을 auto_setup.conf 로 복사해 값을 채운다 (빌드 불필요).
# 형식: 키=값 (# 주석, 값의 따옴표는 선택). 비워 두면 기본 동작.
# 빌드 때 -ldflags -X 로 넣은 값이 있으면 그 값이 우선한다.
#
# 설정 파일 위치 (먼저 발견된 하나만 사용):
#   1) $AUTO_SETUP_CONF/auto_setup.conf
#   2) <auto_setup 실행 파일 디렉터리>/conf/auto_setup.conf
#   3) /etc/auto_setup/auto_setup.conf   (setup.sh 가 conf/auto_setup.conf 를 여기에 설치)

# 모든 대역 접근 가능한 서버 (비우면 os6 경로 미사용)
# (v0.4.0) os8 에서 ping·준비확인이 안 되는 호스트는 설치 중에도 이 서버 경유로 자동 전환
os6_mgmt=
# os6_mgmt 위 gossh 실행 파일 전체 경로
os6_gossh=
# os6_mgmt 위 auto_setup(os6 빌드) 이 있는 디렉터리
os6_autosetup=
# 이 서버의 os_check_final_annotated.sh 전체 경로 (autofs 공유 경로면 os8_mgmt·os6_mgmt 동일)
os_check_sh=
# awx 스크립트 경로 (awxkit/dhcp.sh 등이 있는 awx_script 디렉터리)
awx_dir=

# 비어 있지 않으면 원격 클라이언트 모드 (os6_mgmt 에서 채움)
os8_mgmt=
# os8_mgmt 위 auto_setup 경로 (비면 /usr/local/bin/auto_setup)
os8_autosetup=
# os6_mgmt 위 os_check 경로 (2차 체크용). 비우면 os_check_sh 와 같은 경로, "-" 면 2차 체크 끄기
os6_os_check_sh=
# LDAP 복원용 autofs 공유 경로 (대상 root 가 읽을 수 있어야 함). 비우면 자동 복원 안 함
ldap_share_dir=
