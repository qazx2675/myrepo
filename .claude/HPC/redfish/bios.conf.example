# 레드피시 BIOS 점검 도구 설정 — 복사해서 사용: cp bios.conf.example bios.conf
# 형식: key=value (# 로 시작하는 줄·빈 줄 무시, 줄 끝 주석은 불가)
# 비밀번호는 여기에 적지 않습니다 -> bash encrypt.sh 로 pass.enc 생성

# BMC 계정 ID (필수, 전 벤더 공통 계정 1개)
user=admin

# 암호화된 비밀번호 파일 / AES-256 키 파일 (encrypt.sh 가 0600 으로 생성)
pass_file=pass.enc
key_file=key.bin

# 동시에 접속할 호스트 수
concurrency=100

# 요청 1건당 타임아웃(초)
timeout=20

# true: BMC 자체서명 인증서 검증 생략 / false: 검증
insecure=true

# 일시 오류(UNREACHABLE/TIMEOUT/5xx) 자동 재시도 횟수. 인증 실패(401)는 재시도하지 않음
retries=2

# 계정 잠금 방지: AUTH_FAIL(401) 호스트가 이 수에 이르면 새 호스트 시작을 멈추고 나머지는 SKIPPED_AUTH_STOP (retry.txt 로 재실행).
# 처음 이 수만큼은 한 대씩(직렬) 접속해 로그인이 한 번이라도 성공하면 그때부터 동시 접속(concurrency)으로 전환합니다. 0 이면 끔.
auth_fail_stop=3

# 결과 TSV / 사전조사 덤프 / 프로파일 디렉터리
result_dir=results
dump_dir=dumps
profile_dir=profiles

# 점검·전체비교에서 뺄 BIOS 속성 패턴 (| 로 구분, * 는 0글자 이상 와일드카드, 대소문자 무시). 비우면 없음.
# 전체비교: ignore_attrs.txt(없으면 내장 기본 목록)와 합쳐서 제외. 프로파일 점검: 해당 속성 행을 점검하지 않음.
# 예) exclude_attrs=ServiceTag|*Uuid*|BootSeq*
exclude_attrs=

# on: 전체비교 결과의 difference 도 "위 수정대상을 적용할까요?" 설정 대상에 넣음 / off: 프로파일 항목만 설정 (기본 off)
# (on 이어도 비교서버와 BIOS 버전이 같고, 적용 때 레지스트리 형식이 Enumeration·Integer·Boolean 인 속성만 설정)
allcheck_set=off

# 절대 변경하지 않을 BIOS 속성 패턴 추가 (| 로 구분, * 는 0글자 이상 와일드카드, 대소문자 무시). 비우면 추가 없음.
# 서버 고유값·부팅·보안·RAID·PXE·NIC 관련 속성(IQN, IP, ServerName, BootMode, SecureBoot, *Raid*, *Pxe*, *Nic* 등)은
# 프로그램에 내장된 보호 목록으로 이미 막혀 있으며, 이 설정이나 ignore_attrs.txt 로 끌 수 없습니다 (여기 적은 것은 더하기만 함).
# 보호 속성은 프로파일·전체비교 어느 쪽이든 설정하지 않고 수정 확인 화면에 (수정제외) 로 표시됩니다.
# 예) protect_attrs=MemTest|*Watchdog*|ProcX2Apic
protect_attrs=

# 기준 속성 JSON 폴더 (bios_export 또는 allcheck -export-attrs 로 추출한 파일을 전체비교 기준으로 고를 때)
refs_dir=refs

# 비대화형 점검(bios -auto / -auto-check)에서 -profile 을 주지 않았을 때 쓸 프로파일 이름 (profile_dir/<이름>.tsv).
# 비우면 -profile 이 반드시 필요합니다. 예) auto_profile=VM
auto_profile=
