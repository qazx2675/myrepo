# copy-bridge 설정 파일 샘플
# 실제 사용 시 conf/copy_setting.conf 로 복사해 값을 채우세요.
# ETX(송신, copy-send)와 Windows(수신, copy-widget) 양쪽에 동일한 내용을 둡니다.

# ── AWX 접속 ──────────────────────────────────────────
awx_url        = http://10.20.30.40
username       = admin
password       = changeme
insecure_tls   = true

# 브릿지 전용으로 쓸 Job Template. ID(숫자) 또는 이름 모두 가능.
# 이 템플릿의 description 필드를 텍스트 전달 통로로 사용합니다.
# (YAML 변수 대신 description을 쓰는 이유: YAML 문법 오류 시 저장 자체가
#  실패할 수 있어, 서식 없는 description이 더 안전합니다.)
template       = closed-network-copy

# ETX -> AWX 전송 시 이 줄 수를 넘으면 copy-send가 전송을 거부합니다.
# AWX 웹페이지가 과도하게 긴 텍스트로 느려지는 것을 막기 위한 안전장치입니다.
max_lines      = 200
