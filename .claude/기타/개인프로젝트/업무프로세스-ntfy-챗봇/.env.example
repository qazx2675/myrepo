# 업무프로세스 ntfy 챗봇 환경설정 예시
NTFY_SERVER=https://ntfy.sh

# [모드 1] 단일 토픽 모드 (권장: 휴대폰에서 1개 방만 구독하여 질문/답변/피드백 통합 대화)
NTFY_TOPIC=proc-chat-sample1234

# [모드 2] 분리 토픽 모드 (NTFY_TOPIC을 비우고 아래 3개를 설정하면 각각 분리된 토픽으로 동작)
# NTFY_QUESTION_TOPIC=proc-q-sample1234
# NTFY_ANSWER_TOPIC=proc-a-sample1234
# NTFY_FEEDBACK_TOPIC=proc-fb-sample1234

NTFY_TOKEN=
OLLAMA_URL=http://127.0.0.1:11434
MODEL=qwen3:8b
NUM_CTX=24576
KEEP_ALIVE=30m
TEMPERATURE=0.2
DOC_PATH=D:\업무프로세스\업무프로세스.md
NO_ANSWER_TEXT=문서에 없는 내용입니다.
