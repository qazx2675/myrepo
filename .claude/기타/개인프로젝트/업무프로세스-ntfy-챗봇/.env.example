# 업무프로세스 ntfy 챗봇 환경설정 예시
# 사용법: 이 파일을 복사해 D:\업무프로세스\.env 로 저장한 뒤 수정합니다.
# 주의: 봇은 누락된 키가 있으면 .env 를 다시 쓰며, 그때 주석이 지워집니다.
# 토픽명·토큰 값은 모두 예시 문자열입니다. 실제 값은 이 파일에 적지 않습니다.

# ---- ntfy 서버 / 토픽 ----
NTFY_SERVER=https://ntfy.sh

# [사용자별 개인 토픽 모드 - 기본]
# users.json 이 있으면 이 모드로 동작합니다. users.json 은 봇 최초 실행 시 자동 생성되며
# 사용자별 토픽(proc- 접두 + 128bit 무작위)이 들어갑니다. 토픽은 여기에 직접 적지 않습니다.
# USER_NAMES 는 users.json 을 만들 때만 쓰입니다 (users.json 이 있으면 무시). 미지정 시 사용자1..사용자7
# USER_NAMES=홍길동,김철수,이영희

# [단일 토픽 모드 - 하위 호환]
# 아래 줄의 주석을 풀면 users.json 없이 토픽 1개로 질문/답변/피드백을 처리합니다.
# NTFY_TOPIC=proc-chat-예시문자열

# [분리 토픽 모드]
# NTFY_TOPIC 을 비우고 아래 3개를 설정하면 질문/답변/피드백 토픽이 각각 나뉩니다.
# NTFY_QUESTION_TOPIC=proc-q-예시문자열
# NTFY_ANSWER_TOPIC=proc-a-예시문자열
# NTFY_FEEDBACK_TOPIC=proc-fb-예시문자열

# 보호된 토픽을 쓸 때만 입력 (공란 유지 가능)
NTFY_TOKEN=

# ---- 로컬 LLM (Ollama) ----
OLLAMA_URL=http://127.0.0.1:11434
# 기본 모델 (실험 임시 1위, 사용자 품질 판정 전). 교체 방법은 README 3.1 참고
# 환경변수 MODEL 이 설정돼 있으면 이 값보다 우선합니다.
MODEL=qwen3.5:9b-q8_0
# 컨텍스트 토큰 수. gemma3:12b-it-qat 를 쓸 때는 16384 로 바꿉니다
NUM_CTX=24576
KEEP_ALIVE=30m
TEMPERATURE=0.2
TOP_P=0.8
TOP_K=20
# true: 추론(thinking) 사용 / false: 끔 (기본) / 빈 값: 요청에 think 를 보내지 않음
# 끔을 기본으로 둔 이유는 README 3.2 참고
THINK=false

# ---- 대화 맥락 / 거절 문구 ----
# 사용자별 맥락은 최근 3턴 유지. 마지막 질문 후 이 시간(초)이 지나면 자동 초기화 (/reset 은 즉시 초기화)
CONTEXT_TTL_SEC=600
# 문서 주입 예산 여유분(토큰). 문서 전체 + 고정 문구 + 이 값이 NUM_CTX 를 넘으면 절 선택 모드로 전환
ANSWER_RESERVE=3000
NO_ANSWER_TEXT=문서에 없는 내용입니다.
# 긴 답변 조각 발행 간격(초, 기본 1.2, 최소 1.1). ntfy 시각이 1초 단위라 조각 순서 유지용
# 조각 1개의 최대 크기(UTF-8 바이트, 기본 1000, 범위 300~1300). ntfy.sh 는 푸시 직렬화가 4000바이트를 넘으면
# 앱에서 본문을 중간에서 잘라 보여준다(message 2회·제목 3회·버튼 2회가 계산됨). 한글 1자 = 3바이트
#CHUNK_MAX_BYTES=1000
# 답변을 마크다운으로 발행(기본 true). 앱에서 **굵게**, 목록, ### 제목이 서식으로 보인다. 일반 텍스트로 되돌리려면 false
#MARKDOWN=true
# CHUNK_INTERVAL_SEC=1.2

# ---- 근거 문서 ----
# 기본 문서 (단일). 내용을 고치면 봇 재시작 없이 다음 질문부터 반영됩니다.
DOC_PATH=D:\업무프로세스\업무프로세스.md
# 여러 문서: 세미콜론(;)으로 구분. 지정하면 DOC_PATH 와 DOC_DIR 보다 우선합니다.
# DOC_PATHS=D:\업무프로세스\업무프로세스.md;D:\업무프로세스\추가지침.md
# 폴더 지정: 폴더 안의 .md 파일 전체를 파일명 순으로 읽습니다 (DOC_PATHS 가 비어 있을 때 사용)
# DOC_DIR=D:\업무프로세스\문서
