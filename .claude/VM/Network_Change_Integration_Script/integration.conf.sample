# integration.conf — 통합 망변경 스크립트 중앙 설정
#
# 형식: key = value  (한 줄에 하나, '#' 로 시작하면 주석)
#   - 운영자는 이 파일 하나만 고칩니다.
#   - 일부 값은 실행 직전 각 프로젝트의 conf 로 렌더링되고(§2.2), 나머지는
#     change.sh 가 직접 읽습니다.
#
# ★ 이 파일은 .sample 입니다. integration.conf 로 복사해서 값을 채우십시오.
#   (integration.conf 는 .gitignore 로 커밋 차단)


###############################################################################
# 전처리 (vswitch_${user}.txt 표준화, §4)
###############################################################################

# BM 호스트에 붙일 도메인. vswitch 1열이 도메인 없이 오면 이 값을 붙입니다.
bm_domain = seccae.com

# Case 1/2 변환에서 "폴더명-<이 값>-<IP앞3옥텟>-0" 의 가운데 문자열 기본값.
# 실행 시 -tag 로 덮어쓸 수 있습니다.
preprocess_tag = cae


###############################################################################
# 결과 리다이렉션 (§6)
###############################################################################

# 성공/실패 목록 파일을 남길 디렉터리. change.sh 기준 상대경로 가능.
result_dir = ./results


###############################################################################
# ip_change (C 단계)
###############################################################################

# ip-change-engine 바이너리·conf 경로 (setup.sh 가 빌드해 bin/ 에 둡니다)
ipchange_bin  = ./bin/ip-change-engine
ipchange_conf = ./conf/ip_change.conf

# 아래 값들은 실행 직전 ipchange_conf 로 렌더링됩니다.
ipchange.network_scripts_dir = /etc/sysconfig/network-scripts
ipchange.rhel9_path          =


###############################################################################
# ldap_setting (D 단계)
###############################################################################

ldap_bin  = ./bin/ldap-config-engine

# 운영자가 관리하는 실제 설정/자산 파일 (통합은 이 파일을 고치지 않고 읽기만 함)
#
# ★ 이 폴더는 다른 부서로 단독 이관될 수 있어, myrepo 의 ../../HPC/ldap_setting
#   를 상대경로로 참조하지 않고 이 프로젝트 conf/ 안에 자체 보관합니다.
#   conf/ldap_config.conf.sample, conf/assets.txt.sample 을 conf/ldap_config.conf,
#   conf/assets.txt 로 복사해 값을 채우십시오(둘 다 .gitignore 로 커밋 차단).
#   원본(HPC/ldap_setting)과는 별도 사본이므로, 그쪽 설정이 바뀌면 이 파일도
#   함께 갱신해야 합니다 — 자동 동기화되지 않습니다.
ldap_conf   = ./conf/ldap_config.conf
ldap_assets = ./conf/assets.txt

# 대상 인프라 이름 (ldap_config.conf 의 infra.<이름>)
# ★ 여기서는 지정하지 않습니다. 이전 작업의 값이 그대로 남아 다음 실행에서
#   조용히 다른 인프라에 적용되는 사고를 막기 위해, change.sh 가 매 실행마다
#   ./change.sh --infra <이름> 또는 대화형 선택으로 직접 물어봅니다
#   (원본 ldap_setting 의 "-infra 에 기본값을 두지 말라" 규칙과 동일).

# 자산현황에 없는 호스트에 적용할 site. 비우면 그런 호스트는 건너뜁니다.
# (ev01~ev03 접미사를 뗀 BM 조회까지 실패했을 때만 쓰임 — §11)
default_site =


###############################################################################
# 포트그룹 (E 단계) — vm-network-migration 에 위임
###############################################################################

nm_dir       = ./projects/vm-network-migration
vcenter_file = ./vcenter.txt
vc_id        = lscsystems@vsphere.local
concurrency  = 8
nm_vswitch   = vSwitch0


###############################################################################
# OS 6 분기 (§8.1)
###############################################################################

# 이 파일에 나열된(한 줄에 hostname 하나) 호스트는 OS 6 전용 경로를 씁니다.
# 비우면 전부 일반 경로. 대상이 섞여 있으면 gossh 를 그룹별로 나눠 2회 호출합니다.
os6_hostgroup =
os6_gossh     =
os6_bin_dir   =


###############################################################################
# gossh 접속 (§8.2, §12)
###############################################################################

gossh    = gossh
ssh_user = root
ssh_port = 22
# 비밀번호는 여기 두지 말고 환경변수 GOSSH_PW 로 넘기십시오.

# 2패스 타임아웃(초). 1차는 짧게 돌리고, 타임아웃난 호스트 중 ping 되는 것만
# 2차를 길게 재실행합니다. ping 도 안 되면 즉시 실패로 확정합니다.
timeout_pass1 = 60
timeout_pass2 = 600
