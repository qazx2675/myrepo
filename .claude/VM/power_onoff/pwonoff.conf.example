# /etc/vcetner_pwon_off/pwonoff.conf — vm_power_onoff 설정
# 형식: 키=값, '#' 주석, 빈 줄 무시. 알 수 없는 키·값 오류는 시작 시 즉시 종료(exit 1).
# 이 파일은 root 소유여야 하고 group/other 쓰기 권한이 없어야 한다 (chmod 644, chown root).

# 이 디렉터리에서만 실행 가능 (pwd 가 정확히 같아야 함). 대상 파일 on_off_<user>.txt 도 여기서 읽음 (필수, 절대경로)
allowed_dir=/home/power_onoff

# 선택 가능한 user (번호 1~ 순서 = 적은 순서). 영문 소문자/숫자/_ 만
users=lsh,ljh,dhk

# vCenter 목록 (번호 선택). 0 = 직접 입력
vcenters=192.168.0.50,192.168.0.51
vc_id=lscsystems@vsphere.local

# 비밀번호 암호 파일 (VMsetup 과 공유). 비우면 매번 직접 입력
secret_lib=/home/V2/secret_lib.sh

# 부팅 완료 22 포트 확인: 직접 접속 실패 시 os6_mgmt 경유 (둘 다 채워야 동작, 비우면 직접 확인만)
os6_host=
os6_user=root

# 교차검증(기본 on): 안전장치 3단계(VM 이름 직접 입력)를 확인자(다른 user)의 승인으로 대신한다.
#   2/5 확인자 번호 선택(-c <user> 로 미리 지정 가능, 본인 제외) → 3/5 확인자가 자기 터미널(cross_check --user <확인자>)에서 패스워드로 승인
#   → 4/5 YeS (ls = 대상 보기) → 5/5 카운트다운 → 전원 작업.
# 승인 후 설정된 시간(cross_check.conf 의 approval_ttl_sec, 기본 2분) 안에 4/5·5/5 를 마치지 않으면 승인이 취소된다. -n / --demo 에서는 호출하지 않음.
# 끄려면 cross_check=off (기존 방식: 2/5 Enter, 3/5 VM 이름 입력). on 인데 cross_check_bin 이 없으면 시작하자마자 멈춘다.
# cross_check_bin 은 절대경로 (비우면 기본값)
cross_check=on
cross_check_bin=/usr/local/bin/cross_check

# 입력 제한 시간(초): 계속 대기 상태로 남지 않도록 사용자 입력 한 질문마다 이 시간 안에 답해야 한다 (기본 600 = 10분, 허용 30~3600, 비우면 기본).
#   user·vCenter·기능 번호, 비밀번호, VWP 담당자 확인 문구, 1/5 작업 문구, 2/5(확인자 번호 / Enter), 4/5 YeS(교차검증 방식은 승인 마감 시각을 모를 때만)
#   → 넘기면 "[취소] 입력 시간 N분 초과" 로 끝나고(exit 1) 감사 로그에 사유가 남는다.
#   실행 중 질문(강제 PowerOff YeS/No, 순차 부팅 c/s/q)은 넘기면 No / q(중단)로 처리하고 결과표까지 정상 진행한다.
#   기존 방식의 3/5 VM 이름 입력은 따로 60초 전체 제한, 교차검증 4/5 는 승인 유효시간 마감까지, 3/5 승인 대기는 cross_check 데몬의 wait_timeout_sec.
input_timeout_sec=600

concurrency=200        # 한 번에 vCenter 로 보내는 최대 동시 작업 수 (대상이 이보다 많으면 나머지는 이어서). Off/일괄 On/재부팅은 대상 전체를 한꺼번에 보냄
shutdown_timeout=300      # Guest 종료 대기(초)
boot_timeout=600          # VM 1대 부팅 완료 대기(초)
boot_poll_interval=10     # 부팅 상태 확인 간격(초)
port_check_timeout=3      # 22 포트 연결 제한(초)
