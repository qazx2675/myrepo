# /etc/vcetner_pwon_off/pwonoff.conf — vm_power_onoff 설정
# 형식: 키=값, '#' 주석, 빈 줄 무시. 알 수 없는 키·값 오류는 시작 시 즉시 종료(exit 1).
# 이 파일은 root 소유여야 하고 group/other 쓰기 권한이 없어야 한다 (chmod 644, chown root).

# 이 디렉터리에서만 실행 가능 (pwd 가 정확히 같아야 함). 대상 파일 on_off_<user>.txt 도 여기서 읽음 (필수, 절대경로)
allowed_dir=/home/power_onoff

# 선택 가능한 user (번호 1~ 순서 = 적은 순서). 영문 소문자/숫자/_ 만
users=lsh,ljh,dhk

# vCenter 목록 (번호 선택). 0 = 직접 입력
vcenters=192.168.0.50,192.168.0.51
vc_id=lscsystems@vsphere.local

# 비밀번호 암호 파일 (VMsetup 과 공유). 비우면 매번 직접 입력
secret_lib=/home/V2/secret_lib.sh

# 부팅 완료 22 포트 확인: 직접 접속 실패 시 os6_mgmt 경유 (둘 다 채워야 동작, 비우면 직접 확인만)
os6_host=
os6_user=root

# 교차검증(선택): on 이면 안전장치 1~5단계 통과 직후·전원 작업 직전에 확인자(다른 user)의 승인을 받는다.
# 승인 후 2분 내에 작업을 시작하지 않으면 승인이 취소된다. -n / --demo 에서는 호출하지 않음. 기본 off
# 확인자는 -c <user> 로 지정하거나 번호로 선택 (본인 제외). cross_check_bin 은 절대경로 (비우면 기본값)
cross_check=off
cross_check_bin=/usr/local/bin/cross_check

concurrency=200         # 한 번에 vCenter 로 보내는 최대 동시 작업 수 (대상이 이보다 많으면 나머지는 이어서). Off/일괄 On/재부팅은 대상 전체를 한꺼번에 보냄
shutdown_timeout=300      # Guest 종료 대기(초)
boot_timeout=600          # VM 1대 부팅 완료 대기(초)
boot_poll_interval=10     # 부팅 상태 확인 간격(초)
port_check_timeout=3      # 22 포트 연결 제한(초)
