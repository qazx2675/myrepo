# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올리지 않는다.

# 빗썸 API 키 — 반드시 "조회 전용" 권한으로 발급 (주문 권한 체크 금지)
BITHUMB_ACCESS_KEY=
BITHUMB_SECRET_KEY=

# ntfy 알림 (M5 부터. 폰에 ntfy 앱 설치 후 이 토픽 구독)
# 토픽 이름이 곧 비밀번호다. 길고 추측 불가능하게. 예: clipsend-trade-x7k2p9q
NTFY_TOPIC=
# 보호된 토픽/자가호스팅에서 인증이 필요할 때만. ntfy.sh 공개 토픽이면 비워둠
NTFY_TOKEN=
# 물타기 승인용 별도 토픽 (M8). 폰 알림의 "물타기 승인" 버튼이 여기로 발행하고
# 루프가 이 토픽을 폴링해서 승인을 읽는다. 비우면 폰 승인 비활성(터미널 .bat 만).
# NTFY_TOPIC 과 다른 값으로. 예: clipsend-approve-q4m8p1w
NTFY_APPROVAL_TOPIC=
